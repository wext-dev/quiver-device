CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# build.sh copies the table into ports/esp32, which this path is relative to.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-quiver-8MiB.csv"
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_LWIP_LOCAL_HOSTNAME="quiver"

# A new runtime must confirm itself in its first start (quiver_boot.loader.commit), or the chip
# starts the previous one again. MicroPython's sdkconfig.base sets this too; it must never be off.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
